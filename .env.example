# ==============================================================================
# Library Book Retrieval RAG Engine (LBRE: Ly-Bree) - Environment Configuration
# ==============================================================================

# API Gateway
PORT=3000
NODE_ENV=development

# PostgreSQL & PgVector
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=app
DATABASE_URL=postgres://postgres:postgres@localhost:5432/app

# RabbitMQ Event Bus
RABBITMQ_URL=amqp://guest:guest@localhost:5672

# SeaweedFS (S3-compatible Object Storage for Books)
S3_ENDPOINT=http://localhost:8333
S3_PUBLIC_ENDPOINT=http://localhost:8333
S3_ACCESS_KEY=devaccess
S3_SECRET_KEY=devsecret
S3_BUCKET=books

# Local LLM (Ollama / Llama)
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3.2

# Monitoring (Grafana / OpenTelemetry LGTM)
GF_SECURITY_ADMIN_PASSWORD=admin
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318

# Frontend
VITE_API_BASE_URL=/api

# JWT issued by the auth microservice (auth.users)
JWT_SECRET=dev-only-change-me
JWT_EXPIRES_IN=7d

# SuperTokens (auth service)
# Self-hosted core default. Use the managed URI + API key if you are on SuperTokens Cloud.
SUPERTOKENS_CONNECTION_URI=http://localhost:3567
SUPERTOKENS_API_KEY=
SUPERTOKENS_APP_NAME=Library Book Retrieval
SUPERTOKENS_API_DOMAIN=http://localhost:3000
SUPERTOKENS_WEBSITE_DOMAIN=http://localhost:5173
SUPERTOKENS_API_BASE_PATH=/auth
SUPERTOKENS_WEBSITE_BASE_PATH=/auth
