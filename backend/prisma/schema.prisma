// backend/prisma/schema.prisma
generator client {
  provider     = "prisma-client"
  output       = "../libs/prisma/src/generated"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
  schemas  = ["auth", "book"]   // "knowledge" stays raw SQL
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String
  role         String   @default("student") // admin or student
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@map("users")
  @@schema("auth")
}

model Book {
  id        String   @id @default(uuid())
  title     String
  author    String   @default("Unknown")
  /// EPUB dc:subject values, e.g. ["Fiction", "Sea stories"]
  categories String[] @default([])
  /// EPUB dc:date as written in the file (formats vary: "1851", "1851-10-18")
  publishedDate String?
  description String?
  /// Object-storage key ("covers/x.jpg") or an absolute URL
  coverUrl  String?
  /// Object-storage key of the original EPUB ("epubs/x.epub")
  fileKey   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([title])
  @@map("books")
  @@schema("book")
}
