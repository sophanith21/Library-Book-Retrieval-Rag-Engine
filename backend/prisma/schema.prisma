// backend/prisma/schema.prisma
generator client {
  provider     = "prisma-client"
  output       = "../libs/prisma/src/generated"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
  schemas  = ["auth", "book"]   // "knowledge" stays raw SQL
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String
  role         String   @default("student") // admin or student
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@map("users")
  @@schema("auth")
}

model Book {
  id        String   @id @default(uuid())
  title     String
  author    String   @default("Unknown")
  coverUrl  String?
  fileKey   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("books")
  @@schema("book")
}
